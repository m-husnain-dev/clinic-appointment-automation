    {
      "parameters": {
        "jsCode": "const zone = 'Asia/Karachi';\nconst now = DateTime.now().setZone(zone);\nconst windowStart = now.plus({ hours: 23 });\n   const windowEnd = now.plus({ hours: 25 });\n\nconst out = [];\nfor (const item of $input.all()) {\n  const row = item.json || {};\n  const status = String(row.status || '').toLowerCase().trim();\n  const reminderSent = String(row.reminder_sent || '').toUpperCase().trim();\n  const phone = String(row.patient_contact || '').trim();\n  const dtRaw = String(row.appointment_time || '').trim();\n\n  if (status !== 'confirmed' && status !== 'booked' && status !== 'pending') continue;\n  if (reminderSent === 'TRUE') continue;\n  if (!phone) continue;\n  if (!dtRaw) continue;\n\n  let apptDt = DateTime.fromISO(dtRaw, { zone });\n  if (!apptDt.isValid) apptDt = DateTime.fromISO(dtRaw.replace(' ', 'T'), { zone });\n  if (!apptDt.isValid) continue;\n\n  if (apptDt >= windowStart && apptDt <= windowEnd) {\n    out.push({\n      json: {\n        appointment_id: String(row.appointment_id || ''),\n        patient_name: String(row.patient_name || 'valued patient'),\n        patient_contact: phone,\n        appointment_datetime: dtRaw,\n        doctor: String(row.doctor || 'your doctor'),\n        appointment_display: apptDt.toFormat(\"cccc, dd LLL yyyy 'at' hh:mm a\"),\n      }\n    });\n  }\n}\nreturn out;"
      },
